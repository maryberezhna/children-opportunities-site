{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "crons": [
    {
      "path": "/api/cron/nudge-stuck",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/after-hours",
      "schedule": "0 6,7 * * *"
    },
    {
      "path": "/api/cron/channel-scheduled",
      "schedule": "*/10 * * * *"
    }
  ]
}
